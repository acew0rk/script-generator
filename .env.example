# Copy this file to ".env" and fill in your key.

# Required. Get a FREE key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (current free model).
GEMINI_MODEL=gemini-3.6-flash

# Optional. ElevenLabs speech-to-text key (Speech to Text permission only).
# Enables the "paste a TikTok link" flow. Without it, only paste-a-transcript works.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Leave empty for local use. If set, the whole site asks for this
# password before it works (used on the hosted deployment).
APP_PASSWORD=

# Optional. 127.0.0.1 = this computer only. The host sets this to 0.0.0.0.
HOST=127.0.0.1

# Optional. Defaults to 3000.
PORT=3000
