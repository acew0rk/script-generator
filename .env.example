# Copy this file to ".env" and fill in your key.

# Required. Get a FREE key (no credit card) at https://aistudio.google.com/apikey
# You can list several keys (comma-separated), e.g. from different Google
# accounts, to stretch the free daily quota -- the app rotates and fails over.
GEMINI_API_KEY=

# Optional. Default gemini-flash-lite-latest -- the lite model has a much larger
# free daily allowance; the "-latest" alias self-updates so model retirements
# don't break it. Use gemini-flash-latest for heavier/higher-quality output.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. ElevenLabs speech-to-text key (Speech to Text permission only).
# Enables the "paste a TikTok link" flow. Without it, only paste-a-transcript works.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. When all three are set, every generated script also creates a row in
# the Airtable table. Token needs data.records:write on the base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# Optional. Leave empty for local use. If set, the whole site asks for this
# password before it works (used on the hosted deployment).
APP_PASSWORD=

# Optional. 127.0.0.1 = this computer only. The host sets this to 0.0.0.0.
HOST=127.0.0.1

# Optional. Defaults to 3000.
PORT=3000
